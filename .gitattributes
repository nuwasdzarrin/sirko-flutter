# Normalisasi line-ending: simpan LF di repo, checkout sesuai OS.
* text=auto eol=lf

# Berkas biner — jangan diutak-atik git.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary

# Script: .sh wajib LF (bash), .ps1/.bat CRLF (Windows). DB seed = biner.
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.sqlite binary
*.apk binary
